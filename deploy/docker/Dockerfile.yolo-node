# yolo-node CPU image (onnxruntime backend; also the --mock smoke image). Build context = repo root:
#   docker buildx build -f deploy/docker/Dockerfile.yolo-node --platform linux/arm64 .
# NOT the Jetson Nano image: the TensorRT backend needs JetPack 4.6's Python 3.6 bindings and runs natively under
# systemd (deploy/systemd/yolo-node.service). This image is for a Pi 5 / PC fallback detector and for tests.
# Wheels only (--only-binary=:all:, pinned lock file), so the final image has no compiler, pip or build tools.
# Runs as fixed uid 10104 with a read-only root filesystem (compose adds a tmpfs on /tmp). Models are mounted read-only.
FROM python:3.11-slim-bookworm AS build
COPY deploy/docker/requirements-yolo-node.lock /tmp/requirements.lock
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --only-binary=:all: -r /tmp/requirements.lock \
 && /opt/venv/bin/pip uninstall -y pip >/dev/null

FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/opt/venv/bin:$PATH
RUN groupadd --system --gid 10104 edge \
 && useradd --system --uid 10104 --gid 10104 --no-create-home --shell /usr/sbin/nologin edge \
 && pip uninstall -y pip setuptools wheel >/dev/null 2>&1 || true
COPY --from=build /opt/venv /opt/venv
COPY services/yolo-node/yolo_node /app/yolo_node
COPY deploy/docker/healthcheck.py /app/healthcheck.py
WORKDIR /app
USER 10104:10104
EXPOSE 8400
# /health is open, so a plain 200 check works (no secret in the container)
HEALTHCHECK --interval=30s --timeout=6s --start-period=40s --retries=3 CMD ["python", "/app/healthcheck.py", "8400", "/health", "200"]
ENTRYPOINT ["python", "-m", "yolo_node"]
CMD ["--config", "/etc/edge-agent/config/yolo-node.json"]
