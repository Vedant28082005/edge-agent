# agent image. Build context = repo root:
#   docker buildx build -f deploy/docker/Dockerfile.agent --platform linux/arm64 .
# Wheels only (--only-binary=:all:, pinned lock file), so the final image has no compiler, pip or build tools.
# Runs as fixed uid 10103 with a read-only root filesystem (compose adds a tmpfs on /tmp and one writable data volume).
FROM python:3.11-slim-bookworm AS build
COPY deploy/docker/requirements-agent.lock /tmp/requirements.lock
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --only-binary=:all: -r /tmp/requirements.lock \
 && /opt/venv/bin/pip uninstall -y pip >/dev/null

FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/opt/venv/bin:$PATH
RUN groupadd --system --gid 10103 edge \
 && useradd --system --uid 10103 --gid 10103 --no-create-home --shell /usr/sbin/nologin edge \
 && install -d -o 10103 -g 10103 -m 750 /var/lib/edge-agent \
 && pip uninstall -y pip setuptools wheel >/dev/null 2>&1 || true
COPY --from=build /opt/venv /opt/venv
COPY services/agent/agent /app/agent
COPY deploy/docker/healthcheck.py /app/healthcheck.py
WORKDIR /app
USER 10103:10103
VOLUME ["/var/lib/edge-agent"]
EXPOSE 8200
HEALTHCHECK --interval=30s --timeout=6s --start-period=40s --retries=3 CMD ["python", "/app/healthcheck.py", "8200", "/v1/health", "alive"]
ENTRYPOINT ["python", "-m", "agent"]
CMD ["--config", "/etc/edge-agent/config/agent.json"]
