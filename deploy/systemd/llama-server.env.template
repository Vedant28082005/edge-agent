# /etc/edge-agent/llama-server.env  (mode 640, root:edge-llama). Contains no secret.
# Required: path of the GGUF model. Nothing is downloaded or shipped by this repo. The binary is /usr/local/bin/llama-server (build llama.cpp for the Pi, see docs).
LLAMA_MODEL=/var/lib/edge-agent/models/CHANGE-ME.gguf
# Bind address. 172.29.0.1 is the host's address on the compose `edge` bridge (EDGE_GATEWAY_IP in deploy/.env):
# containers reach it as host.docker.internal, the LAN cannot. Use 127.0.0.1 only with a host-networked agent.
LLAMA_HOST=172.29.0.1
LLAMA_PORT=8080
# Context size in tokens; the agent's prompt budget is about 2k [est], leave room for the reply and the history.
LLAMA_CTX=4096
# Pi 5 has 4 cores; leave one for the services [est].
LLAMA_THREADS=3
# Extra llama-server arguments, e.g. "--mlock" or "--chat-template chatml". Keep it empty if unsure.
LLAMA_EXTRA_ARGS=
