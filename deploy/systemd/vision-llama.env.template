# /etc/edge-agent/vision-llama.env  (mode 640, root:edge-vision). Contains no secret. Nothing is downloaded by this repo.
# Qwen3-VL-2B GGUF (Q4) and its multimodal projector (mmproj GGUF) from the same release.
VLM_MODEL=/var/lib/edge-agent/models/CHANGE-ME-qwen3-vl-2b-q4.gguf
VLM_MMPROJ=/var/lib/edge-agent/models/CHANGE-ME-qwen3-vl-2b-mmproj.gguf
# Loopback port; must match "llama.url" in vision-node.json.
VLM_PORT=8081
# Context: image tokens + question + short answer [est: 2048 is enough; larger costs RAM on the 4GB Pi].
VLM_CTX=2048
# Pi 5 has 4 cores; whisper and the node share them (the node runs one heavy job at a time).
VLM_THREADS=4
# Keep requests out of logs and the web UI off (flag names depend on the llama.cpp build; remove one if the server rejects it).
VLM_EXTRA_ARGS=--no-webui --log-disable
