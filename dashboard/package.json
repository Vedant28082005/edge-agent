{
  "name": "edge-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "gen:api": "openapi-typescript ../contracts/openapi/gateway.yaml -o src/api/schema.gen.ts",
    "check:api": "node scripts/check-api-types.mjs",
    "test": "npm run check:api && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
